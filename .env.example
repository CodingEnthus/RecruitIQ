# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Configuration (PostgreSQL supported, defaults to SQLite local file for zero-config run)
DATABASE_URL=sqlite+aiosqlite:///./recruitiq.db

# Qdrant Vector Database (Defaults to local disk/memory if QDRANT_URL is not set)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=recruitiq_candidate_evidence

# Groq API Configuration for LLM Processing
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# AI Models for Hybrid Search & Reranking
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Anonymization & Security Settings
ENABLE_PROMPT_INJECTION_DEFENSE=true
DEFAULT_ANONYMOUS_MODE=false
